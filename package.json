    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "13.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.1",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
